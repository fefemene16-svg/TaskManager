
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #101827;
    color: white;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
}

.container {
    background: #1e293b;
    width: 90%;
    max-width: 500px;
    padding: 30px;
    border-radius: 15px;
}

h1 {
    color: #38bdf8;
    margin-bottom: 10px;
}

p {
    color: #cbd5e1;
    margin-bottom: 25px;
}

form {
    display: flex;
    gap: 10px;
}

input {
    flex: 1;
    padding: 12px;
    border-radius: 7px;
    border: none;
    min-width: 0;
}

button {
    background: #0ea5e9;
    color: white;
    border: none;
    padding: 12px;
    border-radius: 7px;
    cursor: pointer;
}

h2 {
    margin-top: 25px;
    margin-bottom: 15px;
}

li {
    background: #334155;
    padding: 12px;
    margin-bottom: 8px;
    border-radius: 7px;
    list-style: none;
}
